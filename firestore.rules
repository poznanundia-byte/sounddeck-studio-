rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn();
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['poznanundia@gmail.com', 'nickmundia17@gmail.com'];
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidCreatorProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'role', 'buyMeSodaHandle', 'bio', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == request.auth.uid && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.role is string && data.role in ['artist', 'creator', 'dj']
        && (!('buyMeSodaHandle' in data) || (data.buyMeSodaHandle is string && data.buyMeSodaHandle.size() <= 80))
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 300))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPrivateInfo(data) {
      return data.keys().hasAll(['uid', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'phone', 'phoneCountryCode', 'emailVerified', 'phoneVerified', 'mfaEnrolled', 'instagramHandle', 'facebookPage', 'tiktokHandle', 'whatsappNumber', 'youtubeChannel', 'updatedAt'])
        && data.uid is string && data.uid == request.auth.uid && isValidId(data.uid)
        && (!('email' in data) || (data.email is string && data.email.size() <= 160))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 40))
        && (!('phoneCountryCode' in data) || (data.phoneCountryCode is string && data.phoneCountryCode.size() <= 10))
        && (!('emailVerified' in data) || data.emailVerified is bool)
        && (!('phoneVerified' in data) || data.phoneVerified is bool)
        && (!('mfaEnrolled' in data) || data.mfaEnrolled is bool)
        && (!('instagramHandle' in data) || (data.instagramHandle is string && data.instagramHandle.size() <= 80))
        && (!('facebookPage' in data) || (data.facebookPage is string && data.facebookPage.size() <= 120))
        && (!('tiktokHandle' in data) || (data.tiktokHandle is string && data.tiktokHandle.size() <= 80))
        && (!('whatsappNumber' in data) || (data.whatsappNumber is string && data.whatsappNumber.size() <= 40))
        && (!('youtubeChannel' in data) || (data.youtubeChannel is string && data.youtubeChannel.size() <= 120))
        && data.updatedAt is timestamp;
    }

    function isValidSocialSyncConfig(data) {
      return data.keys().hasAll([
          'uid',
          'autoPublishTracks',
          'autoPublishReels',
          'includeSodaCard',
          'instagramEnabled',
          'tiktokEnabled',
          'soundcloudEnabled',
          'facebookEnabled',
          'whatsappEnabled',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'autoPublishTracks',
          'autoPublishReels',
          'includeSodaCard',
          'instagramEnabled',
          'tiktokEnabled',
          'soundcloudEnabled',
          'facebookEnabled',
          'whatsappEnabled',
          'youtubeEnabled',
          'soundcloudHandle',
          'youtubeChannel',
          'updatedAt'
        ])
        && data.uid is string && data.uid == request.auth.uid && isValidId(data.uid)
        && data.autoPublishTracks is bool
        && data.autoPublishReels is bool
        && data.includeSodaCard is bool
        && data.instagramEnabled is bool
        && data.tiktokEnabled is bool
        && data.soundcloudEnabled is bool
        && data.facebookEnabled is bool
        && data.whatsappEnabled is bool
        && (!('youtubeEnabled' in data) || data.youtubeEnabled is bool)
        && (!('soundcloudHandle' in data) || (data.soundcloudHandle is string && data.soundcloudHandle.size() <= 80))
        && (!('youtubeChannel' in data) || (data.youtubeChannel is string && data.youtubeChannel.size() <= 120))
        && data.updatedAt is timestamp;
    }

    function isValidMusicProject(data) {
      return data.keys().hasAll(['ownerId', 'title', 'genre', 'bpm', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'ownerId',
          'title',
          'category',
          'genre',
          'bpm',
          'musicalKey',
          'timeSignature',
          'lyrics',
          'alignmentNotes',
          'kitName',
          'studioStateJson',
          'createdAt',
          'updatedAt'
        ])
        && data.ownerId is string && data.ownerId == request.auth.uid && isValidId(data.ownerId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && (!('category' in data) || (data.category is string && data.category in ['beat', 'recording', 'song']))
        && data.genre is string && data.genre.size() >= 1 && data.genre.size() <= 60
        && data.bpm is number && data.bpm >= 40 && data.bpm <= 240
        && (!('musicalKey' in data) || (data.musicalKey is string && data.musicalKey.size() <= 32))
        && (!('timeSignature' in data) || (data.timeSignature is string && data.timeSignature.size() <= 16))
        && (!('lyrics' in data) || (data.lyrics is string && data.lyrics.size() <= 8000))
        && (!('alignmentNotes' in data) || (data.alignmentNotes is string && data.alignmentNotes.size() <= 4000))
        && (!('kitName' in data) || (data.kitName is string && data.kitName.size() <= 60))
        && (!('studioStateJson' in data) || (data.studioStateJson is string && data.studioStateJson.size() <= 120000))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidVocalPreset(data) {
      return data.keys().hasAll(['ownerId', 'name', 'presetJson', 'createdAt'])
        && data.keys().hasOnly(['ownerId', 'name', 'description', 'presetJson', 'createdAt'])
        && data.ownerId is string && data.ownerId == request.auth.uid && isValidId(data.ownerId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && (!('description' in data) || (data.description is string && data.description.size() <= 240))
        && data.presetJson is string && data.presetJson.size() >= 2 && data.presetJson.size() <= 8000
        && data.createdAt is timestamp;
    }

    function isValidStudioCollaboration(data) {
      return data.keys().hasAll(['ownerId', 'projectTitle', 'bpm', 'collaboratorEmails', 'stateJson', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'projectTitle', 'bpm', 'musicalKey', 'collaboratorEmails', 'stateJson', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.projectTitle is string && data.projectTitle.size() >= 1 && data.projectTitle.size() <= 120
        && data.bpm is number && data.bpm >= 40 && data.bpm <= 240
        && (!('musicalKey' in data) || (data.musicalKey is string && data.musicalKey.size() <= 32))
        && data.collaboratorEmails is list && data.collaboratorEmails.size() <= 12
        && (data.collaboratorEmails.size() == 0 || data.collaboratorEmails[0] is string)
        && data.stateJson is string && data.stateJson.size() >= 2 && data.stateJson.size() <= 60000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStudioExportLog(data) {
      return data.keys().hasAll(['ownerId', 'projectTitle', 'fileName', 'format', 'sampleRate', 'sizeBytes', 'createdAt'])
        && data.keys().hasOnly(['ownerId', 'projectTitle', 'fileName', 'format', 'sampleRate', 'bitDepth', 'sizeBytes', 'createdAt'])
        && data.ownerId is string && data.ownerId == request.auth.uid && isValidId(data.ownerId)
        && data.projectTitle is string && data.projectTitle.size() >= 1 && data.projectTitle.size() <= 120
        && data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 160
        && data.format is string && data.format in ['wav', 'mp3', 'stems', 'backup_json']
        && data.sampleRate is int && data.sampleRate >= 22050 && data.sampleRate <= 96000
        && (!('bitDepth' in data) || (data.bitDepth is int && data.bitDepth in [16, 24, 32]))
        && data.sizeBytes is int && data.sizeBytes >= 0 && data.sizeBytes <= 500000000
        && data.createdAt is timestamp;
    }

    function isValidSocialCampaign(data) {
      return data.keys().hasAll(['ownerId', 'platform', 'headline', 'caption', 'createdAt'])
        && data.keys().hasOnly(['ownerId', 'platform', 'headline', 'caption', 'trackTitle', 'createdAt'])
        && data.ownerId is string && data.ownerId == request.auth.uid && isValidId(data.ownerId)
        && data.platform is string && data.platform in ['instagram', 'facebook', 'tiktok', 'whatsapp', 'youtube']
        && data.headline is string && data.headline.size() >= 1 && data.headline.size() <= 140
        && data.caption is string && data.caption.size() >= 1 && data.caption.size() <= 2200
        && (!('trackTitle' in data) || (data.trackTitle is string && data.trackTitle.size() <= 120))
        && data.createdAt is timestamp;
    }

    function isValidSocialOmnichannelEvent(data) {
      return data.keys().hasAll(['ownerId', 'platform', 'eventType', 'direction', 'authorName', 'title', 'body', 'status', 'isPublic', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'platform', 'eventType', 'direction', 'authorName', 'authorHandle', 'title', 'body', 'mediaUrl', 'status', 'callState', 'replyText', 'isPublic', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.platform is string && data.platform in ['instagram', 'tiktok', 'whatsapp', 'facebook', 'youtube']
        && data.eventType is string && data.eventType in ['post', 'reel', 'message', 'call', 'comment']
        && data.direction is string && data.direction in ['outbound', 'inbound']
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
        && (!('authorHandle' in data) || (data.authorHandle is string && data.authorHandle.size() <= 120))
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && data.body is string && data.body.size() >= 1 && data.body.size() <= 2200
        && (!('mediaUrl' in data) || (data.mediaUrl is string && data.mediaUrl.size() <= 500))
        && data.status is string && data.status in ['synced', 'pending', 'flagged', 'resolved']
        && (!('callState' in data) || (data.callState is string && data.callState in ['ringing', 'active', 'ended', 'missed']))
        && (!('replyText' in data) || (data.replyText is string && data.replyText.size() <= 1000))
        && data.isPublic is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSodaSupport(data) {
      return data.keys().hasAll(['supporterId', 'supporterName', 'recipientHandle', 'recipientRole', 'sodaCount', 'amountUsd', 'createdAt'])
        && data.keys().hasOnly(['supporterId', 'supporterName', 'recipientHandle', 'recipientRole', 'sodaCount', 'amountUsd', 'message', 'createdAt'])
        && data.supporterId is string && data.supporterId == request.auth.uid && isValidId(data.supporterId)
        && data.supporterName is string && data.supporterName.size() >= 1 && data.supporterName.size() <= 80
        && data.recipientHandle is string && data.recipientHandle.size() >= 1 && data.recipientHandle.size() <= 80
        && data.recipientRole is string && data.recipientRole in ['artist', 'creator', 'dj', 'owner']
        && data.sodaCount is int && data.sodaCount >= 1 && data.sodaCount <= 100
        && data.amountUsd is number && data.amountUsd >= 1 && data.amountUsd <= 1000
        && (!('message' in data) || (data.message is string && data.message.size() <= 280))
        && data.createdAt is timestamp;
    }

    function isValidPadAssignment(data) {
      return data.keys().hasAll(['ownerId', 'padId', 'sampleName', 'sourceType', 'sourceTrackId', 'grooveStyle', 'bpm', 'sliceStartSec', 'sliceDurationSec', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'padId', 'sampleName', 'sourceType', 'sourceTrackId', 'grooveStyle', 'bpm', 'sliceStartSec', 'sliceDurationSec', 'audioBase64', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId == request.auth.uid && isValidId(data.ownerId)
        && data.padId is string && data.padId in ['kick808', 'snare', 'clap', 'hihatClosed', 'hihatOpen', 'logDrum', 'rimshot', 'shaker', 'subBass', 'rhodesC', 'rhodesF', 'rhodesG', 'pluck', 'brass', 'airhorn', 'scratch']
        && data.sampleName is string && data.sampleName.size() >= 1 && data.sampleName.size() <= 120
        && data.sourceType is string && data.sourceType in ['catalog', 'custom_audio']
        && data.sourceTrackId is string && data.sourceTrackId.size() >= 1 && data.sourceTrackId.size() <= 80
        && data.grooveStyle is string && data.grooveStyle in ['afro', 'house', 'trap']
        && data.bpm is number && data.bpm >= 40 && data.bpm <= 240
        && data.sliceStartSec is number && data.sliceStartSec >= 0 && data.sliceStartSec <= 600
        && data.sliceDurationSec is number && data.sliceDurationSec >= 0.1 && data.sliceDurationSec <= 8
        && (!('audioBase64' in data) || (data.audioBase64 is string && data.audioBase64.size() <= 300000))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCommunityActivity(data) {
      return data.keys().hasAll([
          'authorId',
          'authorName',
          'authorRole',
          'activityType',
          'title',
          'detail',
          'likesCount',
          'commentsCount',
          'isPublic',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'authorId',
          'authorName',
          'authorRole',
          'activityType',
          'title',
          'detail',
          'trackTitle',
          'bpm',
          'grooveStyle',
          'milestoneTag',
          'platform',
          'likesCount',
          'commentsCount',
          'isPublic',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.authorId)
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
        && data.authorRole is string && data.authorRole in ['artist', 'creator', 'dj', 'listener']
        && data.activityType is string && data.activityType in ['interaction', 'shared_track', 'milestone']
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && data.detail is string && data.detail.size() >= 1 && data.detail.size() <= 600
        && (!('trackTitle' in data) || (data.trackTitle is string && data.trackTitle.size() <= 120))
        && (!('bpm' in data) || (data.bpm is number && data.bpm >= 40 && data.bpm <= 240))
        && (!('grooveStyle' in data) || (data.grooveStyle is string && data.grooveStyle in ['afro', 'house', 'trap']))
        && (!('milestoneTag' in data) || (data.milestoneTag is string && data.milestoneTag.size() <= 60))
        && (!('platform' in data) || (data.platform is string && data.platform.size() <= 30))
        && data.likesCount is int && data.likesCount >= 0 && data.likesCount <= 1000000
        && data.commentsCount is int && data.commentsCount >= 0 && data.commentsCount <= 100000
        && data.isPublic is bool && data.isPublic == true
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCommunityActivityComment(data, activityId) {
      return data.keys().hasAll(['activityId', 'authorId', 'authorName', 'text', 'isPublic', 'createdAt'])
        && data.keys().hasOnly(['activityId', 'authorId', 'authorName', 'text', 'isPublic', 'createdAt'])
        && data.activityId is string && data.activityId == activityId && isValidId(data.activityId)
        && data.authorId is string && data.authorId == request.auth.uid && isValidId(data.authorId)
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 400
        && data.isPublic is bool && data.isPublic == true
        && data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isSignedIn();
      allow list: if isSignedIn() && existing().role in ['artist', 'creator', 'dj'];
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isVerifiedUser()
        && isValidCreatorProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isValidCreatorProfile(incoming())
        && (isAdmin() || (
          isOwner(userId)
          && isVerifiedUser()
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'role', 'buyMeSodaHandle', 'bio', 'updatedAt'])
        ));
      allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());

      match /private/info {
        allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
        allow create: if isValidId(userId)
          && isOwner(userId)
          && isVerifiedUser()
          && isValidPrivateInfo(incoming())
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId)
          && isValidPrivateInfo(incoming())
          && (isOwner(userId) || isAdmin())
          && isVerifiedUser()
          && incoming().uid == existing().uid
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'phone', 'phoneCountryCode', 'emailVerified', 'phoneVerified', 'mfaEnrolled', 'instagramHandle', 'facebookPage', 'tiktokHandle', 'whatsappNumber', 'youtubeChannel', 'updatedAt']);
        allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());
      }

      match /private/social_sync {
        allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
        allow create: if isValidId(userId)
          && isOwner(userId)
          && isVerifiedUser()
          && isValidSocialSyncConfig(incoming())
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId)
          && isValidSocialSyncConfig(incoming())
          && (isOwner(userId) || isAdmin())
          && isVerifiedUser()
          && incoming().uid == existing().uid
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'autoPublishTracks',
            'autoPublishReels',
            'includeSodaCard',
            'instagramEnabled',
            'tiktokEnabled',
            'soundcloudEnabled',
            'facebookEnabled',
            'whatsappEnabled',
            'youtubeEnabled',
            'soundcloudHandle',
            'youtubeChannel',
            'updatedAt'
          ]);
        allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());
      }
    }

    match /projects/{projectId} {
      allow get: if isValidId(projectId) && isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isValidId(projectId)
        && isVerifiedUser()
        && isValidMusicProject(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(projectId)
        && isValidMusicProject(incoming())
        && (isAdmin() || (
          isVerifiedUser()
          && existing().ownerId == request.auth.uid
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title',
            'category',
            'genre',
            'bpm',
            'musicalKey',
            'timeSignature',
            'lyrics',
            'alignmentNotes',
            'kitName',
            'studioStateJson',
            'updatedAt'
          ])
        ));
      allow delete: if isValidId(projectId) && isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
    }

    match /social_campaigns/{campaignId} {
      allow get: if isValidId(campaignId) && isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isValidId(campaignId)
        && isVerifiedUser()
        && isValidSocialCampaign(incoming())
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(campaignId) && isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
    }

    match /soda_supports/{supportId} {
      allow get: if isValidId(supportId) && isSignedIn();
      allow list: if isSignedIn() && existing().supporterId == request.auth.uid;
      allow create: if isValidId(supportId)
        && isVerifiedUser()
        && isValidSodaSupport(incoming())
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(supportId) && isAdmin();
    }

    match /pad_assignments/{assignmentId} {
      allow get: if isValidId(assignmentId) && isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isValidId(assignmentId)
        && isVerifiedUser()
        && isValidPadAssignment(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(assignmentId)
        && isValidPadAssignment(incoming())
        && (isAdmin() || (
          isVerifiedUser()
          && existing().ownerId == request.auth.uid
          && incoming().ownerId == existing().ownerId
          && incoming().padId == existing().padId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'sampleName',
            'sourceType',
            'sourceTrackId',
            'grooveStyle',
            'bpm',
            'sliceStartSec',
            'sliceDurationSec',
            'audioBase64',
            'updatedAt'
          ])
        ));
      allow delete: if isValidId(assignmentId) && isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
    }

    match /community_activities/{activityId} {
      allow get: if isValidId(activityId) && isSignedIn() && (existing().isPublic == true || existing().authorId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && existing().isPublic == true;
      allow create: if isValidId(activityId)
        && isVerifiedUser()
        && isValidCommunityActivity(incoming())
        && incoming().authorId == request.auth.uid
        && incoming().likesCount == 0
        && incoming().commentsCount == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(activityId)
        && isValidCommunityActivity(incoming())
        && (isAdmin() || (
          isVerifiedUser()
          && incoming().authorId == existing().authorId
          && incoming().activityType == existing().activityType
          && incoming().isPublic == existing().isPublic
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            (existing().authorId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'detail', 'trackTitle', 'bpm', 'grooveStyle', 'milestoneTag', 'updatedAt'])) ||
            (incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'commentsCount', 'updatedAt'])
              && incoming().likesCount >= 0
              && incoming().likesCount >= existing().likesCount - 1
              && incoming().likesCount <= existing().likesCount + 1
              && incoming().commentsCount >= existing().commentsCount
              && incoming().commentsCount <= existing().commentsCount + 1)
          )
        ));
      allow delete: if isValidId(activityId) && isSignedIn() && (existing().authorId == request.auth.uid || isAdmin());

      match /comments/{commentId} {
        allow get: if isValidId(activityId) && isValidId(commentId) && isSignedIn() && existing().isPublic == true;
        allow list: if isSignedIn() && existing().isPublic == true;
        allow create: if isValidId(activityId)
          && isValidId(commentId)
          && isVerifiedUser()
          && isValidCommunityActivityComment(incoming(), activityId)
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/community_activities/$(activityId));
        allow update: if false;
        allow delete: if isValidId(activityId) && isValidId(commentId) && isSignedIn() && (existing().authorId == request.auth.uid || isAdmin());
      }
    }

    match /vocal_presets/{presetId} {
      allow get: if isValidId(presetId) && isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isValidId(presetId)
        && isVerifiedUser()
        && isValidVocalPreset(incoming())
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(presetId) && isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
    }

    match /studio_collaborations/{collabId} {
      allow get: if isValidId(collabId) && isSignedIn() && (
        existing().ownerId == request.auth.uid ||
        (request.auth.token.email_verified == true && request.auth.token.email != null && request.auth.token.email in existing().collaboratorEmails) ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        existing().ownerId == request.auth.uid ||
        (request.auth.token.email_verified == true && request.auth.token.email != null && request.auth.token.email in existing().collaboratorEmails)
      );
      allow create: if isValidId(collabId)
        && isVerifiedUser()
        && isValidStudioCollaboration(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(collabId)
        && isValidStudioCollaboration(incoming())
        && (isAdmin() || (
          isVerifiedUser()
          && (
            existing().ownerId == request.auth.uid ||
            (request.auth.token.email_verified == true && request.auth.token.email != null && request.auth.token.email in existing().collaboratorEmails)
          )
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            (existing().ownerId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['projectTitle', 'bpm', 'musicalKey', 'collaboratorEmails', 'stateJson', 'updatedAt'])) ||
            (incoming().collaboratorEmails == existing().collaboratorEmails && incoming().diff(existing()).affectedKeys().hasOnly(['stateJson', 'updatedAt']))
          )
        ));
      allow delete: if isValidId(collabId) && isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
    }

    match /export_logs/{exportId} {
      allow get: if isValidId(exportId) && isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isValidId(exportId)
        && isVerifiedUser()
        && isValidStudioExportLog(incoming())
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(exportId) && isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
    }

    match /social_events/{eventId} {
      allow get: if isValidId(eventId) && isSignedIn() && (existing().ownerId == request.auth.uid || existing().isPublic == true || isAdmin());
      allow list: if isSignedIn() && (existing().ownerId == request.auth.uid || existing().isPublic == true || isAdmin());
      allow create: if isValidId(eventId)
        && isVerifiedUser()
        && isValidSocialOmnichannelEvent(incoming())
        && (incoming().ownerId == request.auth.uid || isAdmin())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(eventId)
        && isValidSocialOmnichannelEvent(incoming())
        && (isAdmin() || (
          isVerifiedUser()
          && existing().ownerId == request.auth.uid
          && incoming().ownerId == existing().ownerId
          && incoming().platform == existing().platform
          && incoming().eventType == existing().eventType
          && incoming().direction == existing().direction
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'callState', 'replyText', 'body', 'isPublic', 'updatedAt'])
        ));
      allow delete: if isValidId(eventId) && isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
    }
  }
}
