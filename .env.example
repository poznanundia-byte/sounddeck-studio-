# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional external stem separation service (server-side only, never exposed to client):
# Configure either REPLICATE_API_TOKEN (Demucs on Replicate) or a self-hosted STEM_SEPARATION_API_URL
REPLICATE_API_TOKEN=""
STEM_SEPARATION_API_URL=""

# Optional server-side SMS & Email OTP delivery providers (never exposed to client):
# SMS uses Firebase Auth on the client by default (with optional Twilio fallback).
# Email OTP codes support Resend or SendGrid (plus Firebase email verification links).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL=""
OTP_HMAC_SECRET=""

# Google reCAPTCHA v3 & Firebase App Check security configuration:
# Public site key (safe for frontend VITE_ bundle; defaults to configured app key if unset)
VITE_RECAPTCHA_SITE_KEY="6Le3QyMuAAAAACqhl5z87UA-Lt99HEfcuC9rIcsa"
# Set to "true" once this reCAPTCHA key is registered under Firebase Console -> App Check
VITE_ENABLE_FIREBASE_APP_CHECK="false"
# Optional server-side Google reCAPTCHA secret key for strict /api/auth/siteverify checks (keep secret!)
RECAPTCHA_SECRET_KEY=""

# GitHub Pages / Static Hosting Portability:
# Set VITE_BASE_PATH="/your-repo-name/" when hosting under a GitHub Pages subpath (defaults to "./")
VITE_BASE_PATH="./"
# Optional remote backend URL when hosting frontend separately on GitHub Pages (e.g. "https://api.example.com")
VITE_API_ORIGIN=""

# Optional Two-Way Social OAuth & Webhook Credentials (server-side only, never exposed to client):
# Callback URLs follow: ${APP_URL}/api/social/oauth/<platform>/callback
META_APP_ID=""
META_APP_SECRET=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
WHATSAPP_CLOUD_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
SOCIAL_WEBHOOK_VERIFY_TOKEN="sounddeck_social_verify"

